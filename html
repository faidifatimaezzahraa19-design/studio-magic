<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Magique | Création de Contenu 3D, VFX & Vidéo</title>
    <link rel="stylesheet" href="style.css">
    <!-- Police élégante -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;700&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Barre de Navigation -->
    <nav class="navbar">
        <div class="logo">
            <img src="votre-logo.png" alt="Studio Magique Logo">
            <span>Studio Magique</span>
        </div>
        <ul class="nav-links">
            <li><a href="#accueil">Accueil</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#portfolio">Portfolio</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Section Hero (En-tête) -->
    <header id="accueil" class="hero">
        <div class="hero-content">
            <h1>Donnez vie à l'imaginaire</h1>
            <p>Experts en 3D, VFX, Photo, Vidéo et Montage de haute précision.</p>
            <a href="#portfolio" class="btn-main">Découvrir nos projets</a>
        </div>
    </header>

    <!-- Section Services -->
    <section id="services" class="services">
        <h2 class="section-title">Nos Expertises</h2>
        <div class="services-grid">
            <div class="service-card">
                <i class="icon">🧊</i>
                <h3>3D & VFX</h3>
                <p>Modélisation, animation et effets visuels pour le cinéma et la publicité.</p>
            </div>
            <div class="service-card">
                <i class="icon">📷</i>
                <h3>Photo & Vidéo</h3>
                <p>Captation professionnelle avec matériel de pointe pour un rendu cinématographique.</p>
            </div>
            <div class="service-card">
                <i class="icon">🎬</i>
                <h3>Montage & Post-Prod</h3>
                <p>Édition dynamique et étalonnage pour sublimer vos contenus.</p>
            </div>
        </div>
    </section>

    <!-- Section Portfolio (Grille d'images) -->
    <section id="portfolio" class="portfolio">
        <h2 class="section-title">Réalisations</h2>
        <div class="gallery">
            <div class="gallery-item"><img src="thumb1.jpg" alt="VFX Project"></div>
            <div class="gallery-item"><img src="thumb2.jpg" alt="3D Render"></div>
            <div class="gallery-item"><img src="thumb3.jpg" alt="Video Shoot"></div>
            <div class="gallery-item"><img src="thumb4.jpg" alt="Photography"></div>
        </div>
    </section>

    <!-- Pied de page -->
    <footer>
        <p>&copy; 2024 Studio Magique - Tous droits réservés.</p>
        <div class="socials">
            <a href="#">Instagram</a> | <a href="#">Vimeo</a> | <a href="#">LinkedIn</a>
        </div>
    </footer>

</body>
</html>
