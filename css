/* Styles Généraux */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: #0b0b0b; /* Fond sombre pro */
    color: #ffffff;
    scroll-behavior: smooth;
}

/* Navigation */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: rgba(0, 0, 0, 0.9);
    position: fixed;
    width: 100%;
    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 1.5rem;
    color: #00d2ff; /* Couleur d'accent magique */
}

.logo img {
    height: 40px;
    margin-right: 10px;
}

.nav-links {
    list-style: none;
    display: flex;
}

.nav-links li {
    margin-left: 30px;
}

.nav-links a {
    text-decoration: none;
    color: white;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #00d2ff;
}

/* Hero Section */
.hero {
    height: 100vh;
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('votre-image-fond.jpg') center/cover;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.hero h1 {
    font-size: 4rem;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.btn-main {
    display: inline-block;
    padding: 15px 35px;
    background-color: #00d2ff;
    color: black;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    margin-top: 20px;
    transition: 0.3s;
}

/* Services */
.services {
    padding: 100px 8%;
    text-align: center;
}

.section-title {
    font-size: 2.5rem;
    margin-bottom: 50px;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.service-card {
    background: #1a1a1a;
    padding: 40px;
    border-radius: 15px;
    transition: transform 0.3s;
}

.service-card:hover {
    transform: translateY(-10px);
    border: 1px solid #00d2ff;
}

/* Portfolio */
.portfolio {
    padding: 50px 8%;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 15px;
}

.gallery-item img {
    width: 100%;
    border-radius: 10px;
    filter: grayscale(40%);
    transition: 0.5s;
}

.gallery-item img:hover {
    filter: grayscale(0%);
    transform: scale(1.02);
}

/* Footer */
footer {
    padding: 50px;
    text-align: center;
    background: #000;
}
